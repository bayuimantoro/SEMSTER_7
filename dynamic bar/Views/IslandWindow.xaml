<Window x:Class="IslandWin.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IslandWin"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="200" Height="36"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded"
        MouseLeftButtonDown="OnIslandClick">

    <!-- The pill: stretched to window boundaries so inner text length cannot change pill width -->
    <Border x:Name="PillBorder"
            Background="{StaticResource IslandBackground}"
            BorderBrush="{StaticResource IslandStroke}"
            BorderThickness="1"
            CornerRadius="18"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Cursor="Hand">

        <Grid x:Name="ContentGrid" ClipToBounds="True">
            <!-- Compact content: clock + status dot with subtle vertical translate transform -->
            <StackPanel x:Name="CompactContent"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="16,4"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="CompactTransform" X="0" Y="0"/>
                </StackPanel.RenderTransform>
                <Ellipse Width="8" Height="8" Fill="{StaticResource IslandAccent}" Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockText"
                           Text="00:00"
                           Foreground="{StaticResource IslandForeground}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Expanded content: two clean columns (LEFT: media, RIGHT: lyrics) with vertical translate transform -->
            <Grid x:Name="ExpandedContent"
                  Opacity="0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  Margin="14,8,14,8"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExpandedTransform" X="0" Y="0"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Media player (Artwork, Title, Subtitle, Controls) -->
                    <ColumnDefinition Width="190"/>
                    <!-- Column 1: Subtle vertical separator -->
                    <ColumnDefinition Width="1"/>
                    <!-- Column 2: Lyrics panel (Active line + Next line) with constrained width -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: Media Player -->
                <Grid x:Name="MediaColumn"
                      Grid.Row="0" Grid.Column="0"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Artwork -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Metadata + Controls -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Album art: shows artwork when available, falls back to ♫ -->
                    <Border x:Name="ArtworkBorder"
                            Grid.Column="0"
                            Width="48" Height="48"
                            CornerRadius="10"
                            Background="#262626"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <!-- Fallback note glyph, hidden when artwork is shown -->
                            <TextBlock x:Name="ArtworkPlaceholder"
                                       Text="♫" FontSize="22"
                                       Foreground="{StaticResource IslandSubtle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <!-- Artwork image, hidden until a thumbnail arrives -->
                            <Image x:Name="ArtworkImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,48,48" RadiusX="10" RadiusY="10"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Track info & playback controls -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock x:Name="TitleText"
                                   Grid.Row="0"
                                   Text="No media playing"
                                   Foreground="{StaticResource IslandForeground}"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Subtitle: artist or source app -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,1,0,2">
                            <!-- Playback status indicator dot -->
                            <Ellipse x:Name="StatusDot"
                                     Width="6" Height="6"
                                     Fill="{StaticResource IslandAccent}"
                                     Margin="0,0,5,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="SubtitleText"
                                       Text="Ready"
                                       Foreground="{StaticResource IslandSubtle}"
                                       FontSize="11"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Controls row: Segoe Fluent Icons (Win11) with MDL2 fallback -->
                        <StackPanel x:Name="MediaControlsPanel"
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="-4,0,0,0">
                            <Button x:Name="PrevButton"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE892;" FontSize="11"
                                    Width="26" Height="22"
                                    Margin="0,0,2,0"
                                    Click="OnPreviousClick"
                                    IsEnabled="False"
                                    ToolTip="Previous track"/>
                            <Button x:Name="PlayPauseButton"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE768;" FontSize="14"
                                    Width="26" Height="22"
                                    Margin="0,0,2,0"
                                    Click="OnPlayPauseClick"
                                    IsEnabled="False"
                                    ToolTip="Play / Pause"/>
                            <Button x:Name="NextButton"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE893;" FontSize="11"
                                    Width="26" Height="22"
                                    Margin="0,0,2,0"
                                    Click="OnNextClick"
                                    IsEnabled="False"
                                    ToolTip="Next track"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Column 1: Subtle Vertical Divider -->
                <Rectangle Grid.Row="0" Grid.Column="1"
                           Fill="{StaticResource IslandHover}"
                           Width="1"
                           VerticalAlignment="Stretch"
                           Margin="0,4,0,4"/>

                <!-- Column 2: Lyrics Panel (Strictly bounded width, height, and fixed alignment) -->
                <Grid x:Name="LyricsPanel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,2,0">
                    <Grid.RowDefinitions>
                        <!-- Active line row: fixed 34px. Prevents 1-line vs 2-line vertical shifting. -->
                        <RowDefinition Height="34"/>
                        <!-- Next line row: fixed 26px. -->
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <!-- Active line: emphasized with 2-line wrap and ellipsis fallback -->
                    <TextBlock x:Name="ActiveLyricText"
                               Grid.Row="0"
                               Text=""
                               Foreground="{StaticResource IslandForeground}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               MaxHeight="34"
                               LineHeight="17"
                               LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Top"
                               TextOptions.TextFormattingMode="Display"/>

                    <!-- Next line: displayed beneath it with 2-line wrap and ellipsis fallback -->
                    <TextBlock x:Name="NextLyricText"
                               Grid.Row="1"
                               Text=""
                               Foreground="{StaticResource IslandSubtle}"
                               FontSize="11"
                               FontWeight="Normal"
                               Opacity="0.8"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               MaxHeight="26"
                               LineHeight="13"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0,2,0,0"
                               VerticalAlignment="Top"
                               TextOptions.TextFormattingMode="Display"/>
                </Grid>

                <!-- Row 1: Playback timeline at the bottom: elapsed | bar | total (spans all columns) -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"
                      Typography.NumeralAlignment="Tabular">
                    <Grid.ColumnDefinitions>
                        <!-- Fixed widths so the bar length never shifts as the time text changes -->
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PositionText"
                               Grid.Column="0"
                               Text="0:00"
                               Foreground="{StaticResource IslandSubtle}"
                               FontSize="10"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>

                    <!-- Thin interactive progress bar track (taller transparent hit area) -->
                    <Grid x:Name="ProgressBarTrack"
                          Grid.Column="1"
                          Height="12"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonDown="OnProgressBarMouseLeftButtonDown">
                        <!-- Background track -->
                        <Border Height="3"
                                CornerRadius="1.5"
                                Background="{StaticResource ProgressBackground}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                        <!-- Filled progress track -->
                        <Border x:Name="ProgressBarFill"
                                Height="3"
                                CornerRadius="1.5"
                                Background="{StaticResource ProgressFill}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="0"/>
                    </Grid>

                    <TextBlock x:Name="DurationText"
                               Grid.Column="2"
                               Text="0:00"
                               Foreground="{StaticResource IslandSubtle}"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
