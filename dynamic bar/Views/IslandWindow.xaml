<Window x:Class="IslandWin.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IslandWin"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="220" Height="40"
        Loaded="OnLoaded"
        MouseLeftButtonDown="OnIslandClick">

    <!-- The pill: stretched to window boundaries so inner text length cannot change pill width -->
    <Border x:Name="PillBorder"
            Background="{StaticResource IslandBackground}"
            CornerRadius="20"
            Margin="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid x:Name="ContentGrid" ClipToBounds="True">
            <!-- Compact content: clock + status dot with subtle vertical translate transform -->
            <StackPanel x:Name="CompactContent"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="16,4"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="CompactTransform" X="0" Y="0"/>
                </StackPanel.RenderTransform>
                <Ellipse Width="8" Height="8" Fill="{StaticResource IslandAccent}" Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockText"
                           Text="00:00"
                           Foreground="{StaticResource IslandForeground}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Expanded content: two clean columns (LEFT: media, RIGHT: lyrics) with vertical translate transform -->
            <Grid x:Name="ExpandedContent"
                  Opacity="0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  Margin="16,10"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExpandedTransform" X="0" Y="0"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Media player (Artwork, Title, Subtitle, Controls) -->
                    <ColumnDefinition Width="210"/>
                    <!-- Column 1: Subtle vertical separator -->
                    <ColumnDefinition Width="1"/>
                    <!-- Column 2: Lyrics panel (Active line + Next line) with constrained width -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: Media Player -->
                <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Artwork -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Metadata + Controls -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Album art: shows artwork when available, falls back to ♫ -->
                    <Border x:Name="ArtworkBorder"
                            Grid.Column="0"
                            Width="54" Height="54"
                            CornerRadius="10"
                            Background="#262626"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <!-- Fallback note glyph, hidden when artwork is shown -->
                            <TextBlock x:Name="ArtworkPlaceholder"
                                       Text="♫" FontSize="26"
                                       Foreground="{StaticResource IslandSubtle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <!-- Artwork image, hidden until a thumbnail arrives -->
                            <Image x:Name="ArtworkImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,54,54" RadiusX="10" RadiusY="10"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Track info & playback controls -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock x:Name="TitleText"
                                   Grid.Row="0"
                                   Text="No media playing"
                                   Foreground="{StaticResource IslandForeground}"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Subtitle: artist or source app -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,2,0,4">
                            <!-- Playback status indicator dot -->
                            <Ellipse x:Name="StatusDot"
                                     Width="6" Height="6"
                                     Fill="{StaticResource IslandSubtle}"
                                     Margin="0,0,5,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="SubtitleText"
                                       Text="Ready"
                                       Foreground="{StaticResource IslandSubtle}"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Controls row -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="-4,0,0,0">
                            <Button x:Name="PrevButton"
                                    Style="{StaticResource IconButton}"
                                    Content="⏮" FontSize="14"
                                    Margin="0,0,2,0"
                                    Padding="4,2"
                                    Click="OnPreviousClick"
                                    IsEnabled="False"
                                    ToolTip="Previous track"/>
                            <Button x:Name="PlayPauseButton"
                                    Style="{StaticResource IconButton}"
                                    Content="▶" FontSize="16"
                                    Margin="0,0,2,0"
                                    Padding="6,2"
                                    Click="OnPlayPauseClick"
                                    IsEnabled="False"
                                    ToolTip="Play / Pause"/>
                            <Button x:Name="NextButton"
                                    Style="{StaticResource IconButton}"
                                    Content="⏭" FontSize="14"
                                    Padding="4,2"
                                    Click="OnNextClick"
                                    IsEnabled="False"
                                    ToolTip="Next track"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Column 1: Subtle Vertical Divider -->
                <Rectangle Grid.Row="0" Grid.Column="1"
                           Fill="{StaticResource IslandHover}"
                           Width="1"
                           VerticalAlignment="Stretch"
                           Margin="0,4,0,4"/>

                <!-- Column 2: Lyrics Panel (Strictly bounded width, height, and fixed alignment) -->
                <Grid x:Name="LyricsPanel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,4,0">
                    <Grid.RowDefinitions>
                        <!-- Active line row: fixed 36px (2 lines of 18px). Prevents 1-line vs 2-line vertical shifting. -->
                        <RowDefinition Height="36"/>
                        <!-- Next line row: fixed 30px (2 lines of 15px). -->
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <!-- Active line: emphasized with 2-line wrap and ellipsis fallback -->
                    <TextBlock x:Name="ActiveLyricText"
                               Grid.Row="0"
                               Text=""
                               Foreground="{StaticResource IslandForeground}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               MaxHeight="36"
                               LineHeight="18"
                               LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Top"
                               TextOptions.TextFormattingMode="Display"/>

                    <!-- Next line: displayed beneath it with 2-line wrap and ellipsis fallback -->
                    <TextBlock x:Name="NextLyricText"
                               Grid.Row="1"
                               Text=""
                               Foreground="{StaticResource IslandSubtle}"
                               FontSize="11"
                               FontWeight="Normal"
                               FontFamily="Segoe UI"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               MaxHeight="30"
                               LineHeight="15"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0,4,0,0"
                               VerticalAlignment="Top"
                               TextOptions.TextFormattingMode="Display"/>
                </Grid>

                <!-- Row 1: Playback Progress Bar & Time Labels (Spans all columns) -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Thin interactive progress bar track -->
                    <Grid x:Name="ProgressBarTrack"
                          Grid.Row="0"
                          Height="10"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonDown="OnProgressBarMouseLeftButtonDown">
                        <!-- Background track -->
                        <Border Height="3"
                                CornerRadius="1.5"
                                Background="{StaticResource ProgressBackground}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                        <!-- Filled progress track -->
                        <Border x:Name="ProgressBarFill"
                                Height="3"
                                CornerRadius="1.5"
                                Background="{StaticResource ProgressFill}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="0"/>
                    </Grid>

                    <!-- Time labels: Elapsed (left) & Total Duration (right) -->
                    <Grid Grid.Row="1" Margin="0,2,0,0">
                        <TextBlock x:Name="PositionText"
                                   Text="0:00"
                                   Foreground="{StaticResource IslandSubtle}"
                                   FontSize="10"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="DurationText"
                                   Text="0:00"
                                   Foreground="{StaticResource IslandSubtle}"
                                   FontSize="10"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
