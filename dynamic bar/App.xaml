<Application x:Class="IslandWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/IslandWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Global styles -->
        <SolidColorBrush x:Key="IslandBackground" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="IslandForeground" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="IslandAccent" Color="#3DDC84"/>
        <SolidColorBrush x:Key="IslandSubtle" Color="#666666"/>
        <SolidColorBrush x:Key="IslandHover" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ProgressBackground" Color="#333333"/>
        <SolidColorBrush x:Key="ProgressFill" Color="#3DDC84"/>

        <!-- Icon button style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource IslandForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource IslandHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
